<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= course.Title %> | Course Details</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<link rel="stylesheet" href="/Style/course.css">
<style>
/* ==================== PLACEMENT QUIZ OVERLAY STYLES ==================== */

/* Full-screen overlay background with blur effect */
.placement-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    padding: 20px;
    animation: fadeIn .3s ease;
}

/* Fade-in animation for overlay */
@keyframes fadeIn { from{opacity:0} to{opacity:1} }

/* Modal card container */
.placement-modal {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 20px;
    width: 100%;
    max-width: 720px;
    max-height: 90vh;
    overflow-y: auto;
    box-shadow: 0 8px 40px rgba(0,0,0,.12);
    animation: slideUp .4s cubic-bezier(.16,1,.3,1);
}

/* Slide-up animation for modal */
@keyframes slideUp { 
    from{transform:translateY(40px);opacity:0} 
    to{transform:translateY(0);opacity:1} 
}

/* Modal header styling */
.modal-header {
    padding: 32px 36px 0;
    border-bottom: 1px solid #f0f0f4;
    margin-bottom: 28px;
}

/* Tag/badge styling in modal header */
.modal-header .tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #eff6ff;
    color: #2563eb;
    padding: 5px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .8px;
    text-transform: uppercase;
    margin-bottom: 16px;
}

/* Progress bar container */
.quiz-progress-bar {
    height: 3px;
    background: #f3f4f6;
    border-radius: 2px;
    margin-bottom: 28px;
    overflow: hidden;
}

/* Animated progress fill */
.quiz-progress-fill {
    height: 100%;
    background: #2563eb;
    border-radius: 2px;
    transition: width .4s ease;
}

/* Individual question card */
.question-block {
    background: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    padding: 24px;
    margin-bottom: 20px;
    transition: border-color .2s;
}

/* Highlight answered questions with blue border */
.question-block.answered { border-color: #2563eb; }

/* Option label styling for multiple choice */
.opt-label {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    background: #ffffff;
    border: 1.5px solid #e5e7eb;
    border-radius: 10px;
    cursor: pointer;
    transition: all .2s;
    color: #374151;
    font-size: 14px;
}

/* Hover effect on options */
.opt-label:hover { 
    border-color: #2563eb; 
    color: #111827; 
    background: #eff6ff; 
}

/* Selected option styling */
.opt-label.selected { 
    border-color: #2563eb; 
    background: #eff6ff; 
    color: #1d4ed8; 
}

/* True/False button row layout */
.tf-row { display: flex; gap: 12px; }

/* True/False button styling */
.tf-btn-label {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 14px;
    border-radius: 10px;
    border: 1.5px solid #e5e7eb;
    background: #ffffff;
    cursor: pointer;
    font-weight: 600;
    font-size: 15px;
    transition: all .2s;
    color: #6b7280;
}

/* True option checked state - green */
.tf-btn-label:has(input:checked).true-opt { 
    border-color: #16a34a; 
    background: #f0fdf4; 
    color: #15803d; 
}

/* False option checked state - red */
.tf-btn-label:has(input:checked).false-opt { 
    border-color: #dc2626; 
    background: #fef2f2; 
    color: #b91c1c; 
}

/* Hide actual radio inputs for custom styling */
.tf-btn-label input { display: none; }

/* Written answer textarea */
.written-input {
    width: 100%;
    background: #ffffff;
    border: 1.5px solid #e5e7eb;
    border-radius: 10px;
    color: #111827;
    padding: 13px 16px;
    font-size: 14px;
    font-family: inherit;
    outline: none;
    transition: border-color .2s;
    resize: vertical;
    min-height: 80px;
}

/* Red border on focus for written answers */
.written-input:focus { border-color: #dc2626; }

/* ==================== RESULT SCREEN STYLES ==================== */

/* Result screen container - hidden by default */
.result-screen {
    display: none;
    padding: 48px 36px;
    text-align: center;
    flex-direction: column;
    align-items: center;
    gap: 24px;
}

/* Show when visible class is added */
.result-screen.visible { display: flex; }

/* Circular score display */
.score-ring {
    width: 140px;
    height: 140px;
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border: 4px solid;
    margin: 0 auto;
    animation: popIn .5s cubic-bezier(.34,1.56,.64,1);
}

/* Pop-in animation for score ring */
@keyframes popIn { 
    from{transform:scale(.5);opacity:0} 
    to{transform:scale(1);opacity:1} 
}

/* Level-specific color schemes */
.score-ring.beginner     { border-color: #16a34a; background: #f0fdf4; }
.score-ring.intermediate { border-color: #ea580c; background: #fff7ed; }
.score-ring.advanced     { border-color: #2563eb; background: #eff6ff; }

/* Level pill badges */
.level-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 24px;
    border-radius: 50px;
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    font-family: 'Syne', sans-serif;
}
.level-pill.beginner     { background: #f0fdf4; color: #15803d; border: 2px solid #16a34a; }
.level-pill.intermediate { background: #fff7ed; color: #c2410c; border: 2px solid #ea580c; }
.level-pill.advanced     { background: #eff6ff; color: #1d4ed8; border: 2px solid #2563eb; }
</style>
</head>
<body>

<div class="page-container">
    <!-- Sidebar toggle button for mobile -->
    <button class="sidebar-hidden-toggle" id="sidebarHiddenToggle">
        <i class="fas fa-bars"></i>
    </button>

    <!-- ==================== SIDEBAR ==================== -->
    <div class="sidebar" id="sidebar">
        <div class="logo" id="logoToggle">
            <div class="logo-content">
                <img src="/img/logoBleu.png" class="logo-img">
                <span>My Courses</span>
            </div>
            <i class="fas fa-chevron-left toggle-icon"></i>
        </div>
        <div class="menu">
            <ul>
                <li><a href="/courses/All">All Courses</a></li>
                <li><a href="/studentDashboard/">Dashboard</a></li>
                <li><a href="/favoriteCourses/All">Favorite Courses</a></li>
                <li><a href="/profile/Profile-view">My Profile</a></li>
            </ul>
        </div>
        <a href="/home">
            <button class="logout" id="logoutBtn"><i class="fas fa-sign-out-alt"></i> Sign out</button>
        </a>
    </div>

    <!-- ==================== MAIN CONTENT ==================== -->
    <div class="main" id="mainContent">
        <div class="main-header">
            <h2>Course <span>Details</span></h2>
        </div>

        <div class="course-container">
            <!-- Course Header Section -->
            <div class="course-header">
                <h1><%= course.Title %></h1>
                
                <!-- Course meta information (instructor, rating, lessons count) -->
                <div class="course-meta">
                    <span><i class="fas fa-chalkboard-user"></i> <%= course.Instructor?.userName || "Instructor" %></span>
                    <span>
                        <i class="fas fa-star" style="color:var(--orange)"></i>
                        <%= course.rating?.length ? `${Number(course.averageRating || 0).toFixed(1)} (${course.rating.length} ratings)` : "No ratings yet" %>
                    </span>
                    <span><i class="fas fa-book"></i> <%= course.lessons?.length || 0 %> lessons</span>
                </div>
                
                <!-- Course description -->
                <p class="course-description"><%= course.Description %></p>

                <!-- Placement Quiz Section -->
                <div class="quiz-section">
                    <h3><i class="fas fa-brain"></i> Level Assessment Quiz</h3>
                    <p>Complete this quiz to unlock personalized lessons tailored to your skill level.</p>
                    <% if(showPlacementQuiz && placementQuiz) { %>
                        <!-- Button to open quiz overlay -->
                        <button class="quiz-btn" onclick="document.getElementById('placementOverlay').style.display='flex'">
                            <i class="fas fa-play-circle"></i> Start Level Quiz
                        </button>
                    <% } else { %>
                        <p style="color:#888;margin-top:12px"><i class="fas fa-info-circle"></i> No placement quiz available yet.</p>
                    <% } %>
                </div>

                <!-- Student Progress Section -->
                <div class="progress-section">
                    <div class="progress-label">
                        <span>Your Progress</span>
                        <span><strong id="progressPercent"><%= courseStats?.progressPercent || 0 %>%</strong></span>
                    </div>
                    <div class="progress-bar">
                        <div class="progress-fill" id="progressFill" style="width:<%= courseStats?.progressPercent || 0 %>%"></div>
                    </div>
                </div>
            </div>

            <!-- Quick Stats Section -->
            <div class="stats-full-width">
                <h3><i class="fas fa-chart-simple"></i> Quick Stats</h3>
                <div class="stats-grid">
                    <div class="stat-item">
                        <i class="fas fa-check-circle"></i>
                        <span>Lessons Completed</span>
                        <strong id="completedCount"><%= courseStats?.completedLessons || 0 %>/<%= courseStats?.totalLessons || 0 %></strong>
                    </div>
                    <div class="stat-item">
                        <i class="fas fa-fire"></i>
                        <span>Current Streak</span>
                        <strong><%= courseStats?.currentStreak || 0 %> days</strong>
                    </div>
                    <div class="stat-item">
                        <i class="fas fa-hourglass-half"></i>
                        <span>Time Spent</span>
                        <strong id="timeSpent"><%= courseStats?.timeSpentText || "0h 0m" %></strong>
                    </div>
                    <div class="stat-item">
                        <i class="fas fa-trophy"></i>
                        <span>Quiz Average</span>
                        <strong><%= courseStats?.quizAverage || 0 %>%</strong>
                    </div>
                </div>
            </div>

            <!-- Course Content / Lessons List -->
            <div class="content-section">
                <h2 class="section-title"><i class="fas fa-list"></i> Course Content</h2>
                <% if(course.lessons && course.lessons.length > 0){ %>
                    <% course.lessons.forEach((lesson, index) => { %>
                    <div class="lesson-item" data-progress="0">
                        <div class="lesson-info">
                            <i class="fas fa-play-circle"></i>
                            <div>
                                <h4>Lesson <%= index+1 %>: <%= lesson.name %></h4>
                                <p><%= lesson.type || "Video" %> · <%= lesson.level %></p>
                            </div>
                        </div>
                        <!-- Locked until quiz is completed -->
                        <div class="lesson-progress">🔒 Complete quiz first</div>
                    </div>
                    <% }) %>
                <% } else { %>
                    <p>No lessons available yet.</p>
                <% } %>
            </div>
        </div>
    </div>
</div>

<!-- ==================== PLACEMENT QUIZ OVERLAY ==================== -->
<% if(showPlacementQuiz && placementQuiz) { %>
<div class="placement-overlay" id="placementOverlay" style="display:none">
    <div class="placement-modal">

        <!-- QUIZ FORM SECTION (visible initially) -->
        <div id="quizForm">
            <div class="modal-header">
                <div class="tag"><i class="fas fa-brain"></i> Placement Quiz</div>
                <h2><%= placementQuiz.title %></h2>
                <p>Answer all questions honestly. Your results determine your starting level — beginner, intermediate, or advanced.</p>
                <!-- Progress bar for quiz completion -->
                <div class="quiz-progress-bar">
                    <div class="quiz-progress-fill" id="quizProgressFill" style="width:0%"></div>
                </div>
            </div>

            <div class="modal-body">
                <form id="placementForm">
                    <input type="hidden" name="courseId" value="<%= course._id %>">
                    <input type="hidden" name="quizId" value="<%= placementQuiz._id %>">

                    <!-- Loop through all quiz questions -->
                    <% placementQuiz.questions.forEach((q, idx) => { %>
                        <!-- Different question types have different UI -->
                        <!-- multiple-choice, true-false, multi-select, written -->
                    <% }) %>
                </form>
            </div>

            <div class="modal-footer">
                <span class="quiz-counter" id="answerCounter">0 / <%= placementQuiz.questions.length %> answered</span>
                <button class="quiz-submit-btn" id="submitBtn" onclick="submitPlacementQuiz()">
                    <i class="fas fa-paper-plane"></i> Submit Quiz
                </button>
            </div>
        </div>

        <!-- RESULT SCREEN SECTION (hidden initially, shown after submission) -->
        <div class="result-screen" id="resultScreen">
            <div class="level-icon" id="resultIcon">🌱</div>
            <div class="score-ring" id="scoreRing">
                <div class="score-pct" id="scorePct">0%</div>
                <div class="score-label">YOUR SCORE</div>
            </div>
            <div class="result-title">Your Level is Determined!</div>
            <div class="level-pill" id="levelPill">Beginner</div>
            <div class="result-desc" id="resultDesc"></div>
            <a href="#" class="start-learning-btn" id="startLearningBtn">
                <i class="fas fa-rocket"></i> Start Learning
            </a>
        </div>
    </div>
</div>
<% } %>

<script>
// ==================== QUIZ JAVASCRIPT FUNCTIONS ====================

// Get total number of questions from server-side variable
const TOTAL_QUESTIONS = <%= (placementQuiz && placementQuiz.questions) ? placementQuiz.questions.length : 0 %>;
// Set to track which questions have been answered
const answeredSet = new Set();

/**
 * markAnswered - Marks a question as answered and highlights its container
 * @param {number} idx - The question index
 */
function markAnswered(idx) {
    answeredSet.add(idx);
    document.querySelector(`#qblock-${idx}`)?.classList.add('answered');
}

/**
 * selectOpt - Handles selection of options for radio/checkbox questions
 * @param {number} qIdx - Question index
 * @param {number} optIdx - Option index
 * @param {string} type - 'radio' for single-select or 'check' for multi-select
 */
function selectOpt(qIdx, optIdx, type) {
    markAnswered(qIdx);
    const siblings = document.querySelectorAll(`[id^="opt-${qIdx}-"]`);
    siblings.forEach(el => el.classList.remove('selected'));
    
    if (type === 'radio') {
        // Single select - add selected class only to clicked option
        document.getElementById(`opt-${qIdx}-${optIdx}`)?.classList.add('selected');
    } else {
        // Multi-select - add selected class to all checked checkboxes
        siblings.forEach(el => {
            const cb = el.querySelector('input[type="checkbox"]');
            if (cb?.checked) el.classList.add('selected');
        });
    }
}

/**
 * updateProgress - Updates the progress bar and answer counter based on answered questions
 */
function updateProgress() {
    const filled  = document.getElementById('quizProgressFill');
    const counter = document.getElementById('answerCounter');
    const pct = TOTAL_QUESTIONS ? (answeredSet.size / TOTAL_QUESTIONS * 100) : 0;
    if (filled)  filled.style.width = pct + '%';
    if (counter) counter.textContent = `${answeredSet.size} / ${TOTAL_QUESTIONS} answered`;
}

/**
 * submitPlacementQuiz - Collects all answers and sends them to the server
 * Handles both single answers and multi-select answers
 */
async function submitPlacementQuiz() {
    const form = document.getElementById('placementForm');
    if (!form) return;

    // Disable submit button and show loading state
    const btn = document.getElementById('submitBtn');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Submitting…';

    const formData   = new FormData(form);
    const answers    = {};
    const multiSelect = {};

    // Process form data to separate single answers from multi-select answers
    for (const [key, value] of formData.entries()) {
        const msMatch = key.match(/^answers\[(\d+)\]\[\]$/);  // Multi-select format
        const sMatch  = key.match(/^answers\[(\d+)\]$/);      // Single answer format
        
        if (msMatch) {
            const i = msMatch[1];
            if (!multiSelect[i]) multiSelect[i] = [];
            multiSelect[i].push(value);
        } else if (sMatch) {
            answers[sMatch[1]] = value;
        }
    }
    
    // Merge multi-select answers into main answers object
    Object.entries(multiSelect).forEach(([i, vals]) => { answers[i] = vals; });

    // Prepare payload for API request
    const payload = { 
        courseId: formData.get('courseId'), 
        answers 
    };
    const quizId = formData.get('quizId');
    if (quizId) payload.quizId = quizId;

    try {
        // Send POST request to submit quiz
        const res  = await fetch('/courses/api/submit-quiz', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify(payload)
        });
        const data = await res.json();

        if (data.success) {
            showResult(data);  // Display results on success
        } else {
            alert(data.message || 'Something went wrong.');
            // Re-enable button on error
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-paper-plane"></i> Submit Quiz';
        }
    } catch (err) {
        alert('Network error: ' + err.message);
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-paper-plane"></i> Submit Quiz';
    }
}

/**
 * showResult - Displays quiz results with animated score and level badge
 * @param {Object} data - Response data containing score, level, redirectUrl, etc.
 */
function showResult(data) {
    // Hide quiz form, show result screen
    document.getElementById('quizForm').style.display = 'none';
    document.getElementById('resultScreen').classList.add('visible');

    const scoreRing = document.getElementById('scoreRing');
    const scorePct  = document.getElementById('scorePct');

    // Apply level-specific styling to score ring
    scoreRing.className = 'score-ring ' + data.level;

    // Update level pill with appropriate styling and text
    const pill = document.getElementById('levelPill');
    pill.className = 'level-pill ' + data.level;
    pill.textContent = data.level.charAt(0).toUpperCase() + data.level.slice(1);

    // Set result description text
    document.getElementById('resultDesc').textContent = data.levelDescription || '';

    // Animate score from 0 to actual score percentage
    animateNumber(scorePct, 0, Math.round(data.score), 800);

    // Redirect to learning page after 2 seconds
    setTimeout(() => {
        window.location.href = data.redirectUrl;
    }, 2000);
}

/**
 * animateNumber - Animates counting from one number to another
 * @param {HTMLElement} el - Element to update with the number
 * @param {number} from - Starting value
 * @param {number} to - Ending value
 * @param {number} duration - Animation duration in milliseconds
 */
function animateNumber(el, from, to, duration) {
    const start  = performance.now();
    const update = (now) => {
        const t = Math.min((now - start) / duration, 1);
        el.textContent = Math.round(from + (to - from) * t) + '%';
        if (t < 1) requestAnimationFrame(update);
    };
    requestAnimationFrame(update);
}
</script>

<!-- External course details script -->
<script src="/js/course-details.js"></script>
</body>
</html>