<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Reset Password - Eduphin</title>
    <!-- External CSS for styling -->
    <link rel="stylesheet" href="/Style/Register.css">
    <!-- Font Awesome 6 icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>
<body>

<!-- ==================== MAIN AUTHENTICATION WRAPPER ==================== -->
<div class="auth-wrapper">

    <!-- ==================== LEFT PANEL - RESET PASSWORD FORM ==================== -->
    <div class="credentials-panel signin">
        <h2 class="slide-element">Reset Password</h2>

        <!-- Form submits to /auth/reset-password endpoint -->
        <form action="/auth/reset-password" method="POST">

            <!-- Hidden field to store the reset token -->
            <!-- Token is passed from the server (extracted from URL query parameter) -->
            <input type="hidden" name="token" value="<%= token %>">

            <!-- New Password Field -->
            <div class="field-wrapper slide-element">
                <input type="password" name="password" id="newPassword" required placeholder=" ">
                <label>New Password</label>
                <!-- Eye icon to toggle password visibility -->
                <i class="fas fa-lock toggle-password" id="toggleNewPassword"></i>
            </div>

            <!-- Confirm Password Field -->
            <div class="field-wrapper slide-element">
                <input type="password" name="confirmPassword" id="confirmPassword" required placeholder=" ">
                <label>Confirm Password</label>
                <!-- Eye icon to toggle password visibility -->
                <i class="fas fa-lock toggle-password" id="toggleConfirmPassword"></i>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="submit-button slide-element">
                Update Password
            </button>

            <!-- Link to navigate back to login page -->
            <div class="switch-link slide-element">
                <a href="/login">Back to Login</a>
            </div>

        </form>
    </div>

    <!-- ==================== RIGHT PANEL - WELCOME MESSAGE ==================== -->
    <div class="welcome-section signin">
        <h2 class="slide-element">Almost there 🚀</h2>
        <p class="slide-element">
            Choose a strong password to secure your account.
        </p>
    </div>

</div>

<!-- Footer -->
<div class="footer">© 2026 Eduphin All Rights Reserved</div>

<!-- ==================== JAVASCRIPT FOR PASSWORD TOGGLE ==================== -->
<script>
    /**
     * PASSWORD VISIBILITY TOGGLE FUNCTIONALITY
     * Allows users to show/hide password text by clicking the eye icon
     */
    
    // Get DOM elements for New Password field
    const toggleNewPassword = document.getElementById("toggleNewPassword");
    const newPassword = document.getElementById("newPassword");

    // Get DOM elements for Confirm Password field
    const toggleConfirmPassword = document.getElementById("toggleConfirmPassword");
    const confirmPassword = document.getElementById("confirmPassword");

    toggleNewPassword.addEventListener("click", function () {
        // Check current input type
        if (newPassword.type === "password") {
            // Change to visible text
            newPassword.type = "text";
            // Update icon to unlocked
            this.classList.remove("fa-lock");
            this.classList.add("fa-unlock");
        } else {
            // Change back to hidden password
            newPassword.type = "password";
            // Update icon back to lock
            this.classList.remove("fa-unlock");
            this.classList.add("fa-lock");
        }
    });

    /**
     * Toggle visibility for Confirm Password field
     * Same functionality as new password toggle
     */
    toggleConfirmPassword.addEventListener("click", function () {
        if (confirmPassword.type === "password") {
            confirmPassword.type = "text";
            this.classList.remove("fa-lock");
            this.classList.add("fa-unlock");
        } else {
            confirmPassword.type = "password";
            this.classList.remove("fa-unlock");
            this.classList.add("fa-lock");
        }
    });
</script>

</body>
</html>