<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Eduphin | Teacher Dashboard</title>
    <!-- External CSS for teacher dashboard styling -->
    <link rel="stylesheet" href="/Style/teacherdashboard.css">
    <!-- Font Awesome 6 icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Chart.js library for analytics charts -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>

<div class="page-container">

    <!-- ==================== SIDEBAR ==================== -->
    <div class="sidebar">
        <div class="logo">
            <img src="/img/logoBleu.png" class="logo-img" alt="logo">
            <span>Eduphin</span>
        </div>
        <div class="menu">
            <ul>
                <li class="active">Home</li>
                <li><a href="/profile/Profile-view">My Profile</a></li>
                <li><a href="/App/createCourse">Create Course</a></li>
                <li><a href="/App/studentAnalytics">Student Analytics</a></li>
            </ul>
        </div>
        <!-- Logout button redirects to home page -->
        <a href="/home">
            <button class="logout" id="logoutBtn"><i class="fas fa-sign-out-alt"></i> Sign out</button>
        </a>
    </div>

    <!-- ==================== MAIN CONTENT ==================== -->
    <div class="main">

        <!-- HEADER with search and profile -->
        <div class="main-header">
            <h2>Teacher <span>Dashboard</span></h2>
            <div class="header-actions">
                <!-- Search input for filtering courses -->
                <input type="text" id="searchInput" class="search-bar" placeholder="Search for courses...">
                <div class="buttons">
                    <!-- Profile button -->
                    <a href="/profile/Profile-view">
                        <button class="icon-btn">👤</button>
                    </a>
                </div> 
            </div>
        </div>
        
        <br>

        <!-- ==================== WELCOME SECTION ==================== -->
        <div class="welcome">
            <div>
                <!-- Display logged-in teacher's username -->
                <h2>Welcome, Professor <%= user.userName %> 👋</h2>
                <p>Shape the future of learning by building interactive courses, <br> adapting content to every student, and unlocking powerful insights.</p>
            </div>
        </div>
        
        <br>

        <!-- ==================== OVERVIEW STATISTICS ==================== -->
        <h3>Overview</h3>

        <div class="dashboard-container">
            <div class="cards">

                <!-- CARD 1: Total Courses -->
                <div class="card">
                    <div class="feature-icon icon-blue">
                        <i class="fa-solid fa-book"></i>
                    </div>
                    <h4> <span class="orange">Total</span> <span class="blue">Courses</span></h4>
                    <p class="big"><%= totalCourses %></p>
                    <span class="small-text">Courses created</span>
                </div>

                <!-- CARD 2: Quiz Repository -->
                <div class="card">
                    <div class="feature-icon icon-orange">
                        <i class="fa-solid fa-clipboard-list"></i>
                    </div>
                    <h4> <span class="orange">Quiz</span> <span class="blue">Repository</span></h4>
                    <p class="big"><%= totalQuizzes %></p>
                    <span class="small-text">Available quizzes</span>
                </div>

                <!-- CARD 3: Total Students -->
                <div class="card">
                    <div class="feature-icon icon-cryan">
                        <i class="fa-solid fa-users"></i>
                    </div>
                    <h4><span class="orange">Total</span> <span class="blue">Students</span></h4>
                    <p class="big"><%= totalStudents %></p>
                    <span class="small-text">Active learners</span>
                </div>

            </div>
        </div>

        <br>

        <!-- ==================== COURSES SECTION ==================== -->
        <h3>Course Section</h3>

        <div class="courses">

            <!-- Check if teacher has any courses -->
            <% if (courses && courses.length > 0) { %>

                <!-- Loop through all courses and display each as a card -->
                <% courses.forEach(course => { %>

                    <div class="course">

                        <!-- Show "Top Rated" badge for courses with rating >= 4 -->
                        <% if (course.averageRating >= 4) { %>
                            <span class="badge-top">🔥 Top Rated</span>
                        <% } %>

                        <!-- Course title -->
                        <h4><%= course.Title %></h4>

                        <!-- Course image -->
                        <img src="<%= course.image %>" class="course-img">

                        <!-- Action buttons for course management -->
                        <div class="buttons">
                            <!-- Edit button - redirects to course edit page -->
                            <button onclick="getCourse('<%= course.slug %>')">
                                Edit
                            </button>

                            <!-- Delete button - shows confirmation before deletion -->
                            <button onclick="deleteCourse('<%= course.slug %>')">
                                Delete
                            </button>
                            
                            <!-- Content button - manage course lessons/content -->
                            <button class="content-btn" onclick="window.location.href='/courses/content/<%= course.slug %>'">
                                Content
                            </button>
                        </div>

                        <!-- Dynamic rating class based on average rating -->
                        <%
                            let ratingClass = "low";
                            if (course.averageRating >= 4) ratingClass = "good";
                            else if (course.averageRating >= 3) ratingClass = "mid";
                        %>

                        <!-- Display average rating with stars -->
                        <p class="rating <%= ratingClass %>">
                            ⭐ <%= course.averageRating %> / 5
                        </p>

                        <!-- Number of ratings -->
                        <p>(<%= course.ratingsCount %> ratings)</p>

                        <!-- Insight message based on rating -->
                        <p class="insight">
                            👥 <%= course.ratingsCount %> reviews •
                            <% if (course.averageRating >= 4) { %>
                                Excellent performance 🚀
                            <% } else if (course.averageRating >= 3) { %>
                                Stable course 📈
                            <% } else if (course.ratingsCount > 0) { %>
                                Low satisfaction ⚠️
                            <% } else { %>
                                No student feedback yet
                            <% } %>
                        </p>

                    </div>

                <% }) %>

            <% } else { %>

                <!-- Empty state when teacher has no courses -->
                <div class="empty-state">
                    <h3>No Courses yet</h3>
                    <div class="empty-icon">💔</div>
                    <a href="/App/createCourse" class="browse-btn">Create Course</a>
                </div>

            <% } %>

        </div>

        <!-- ==================== FOOTER ==================== -->
        <div class="footer">© 2026 Eduphin. All Rights Reserved.</div>

    </div>
</div>

<!-- ==================== JAVASCRIPT ==================== -->
<script>

    /**
     * Safely update teacher name element if it exists in the DOM
     * Prevents errors if element ID doesn't match
     */
    const teacherNameEl = document.getElementById("teacherName");
    if (teacherNameEl) {
        teacherNameEl.innerText = "Welcome, Professor <%= user.userName %> 👋";
    }

    
    const deleteCourse = async (slug) => {
        try {
            // Ask for user confirmation before deletion
            const ok = confirm("Are you sure you want to delete this course?");
            if (!ok) return;

            // Send delete request to server
            const res = await fetch(`/courses/delete/${slug}`, {
                method: "POST",
                credentials: "include"  // Include cookies for authentication
            });

            const data = await res.json();

            // Handle successful deletion
            if (data.message === "Course deleted successfully") {
                alert("Course deleted successfully");
                window.location.reload();  // Refresh page to update list
                return;
            }

            // Handle course not found
            if (data.message === "Course not found") {
                alert("Course not found");
                return;
            }

            // Handle unauthorized deletion attempt
            if (data.message === "Not authorized to delete this course") {
                alert("Not authorized");
                return;
            }

            // Generic error message for other cases
            alert("Something went wrong");

        } catch (err) {
            console.error(err);
            alert("Server error");
        }
    };

    /**
     * getCourse - Navigates to the course edit page
     * @param {string} slug - The unique slug identifier for the course
     */
    const getCourse = async (slug) => {
        window.location.href = `/courses/getCourse/${slug}`;
    };

</script>

</body>
</html>