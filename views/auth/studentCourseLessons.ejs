<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<!-- Responsive Design -->
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<!-- Dynamic Page Title -->
<title><%= course.Title %> - Lessons</title>
<!-- Font Awesome Icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<link rel="stylesheet" href="/Style/dashboard.css">
<link rel="stylesheet" href="/Style/courseLesson.css">
<style>

/* General Body Styling */
body{
font-family:Arial,sans-serif;
background:#f5f6fa;
margin:0;
padding:0;
}

/* Main Page Container */
.course-page-container{
width:100%;
padding:24px 32px;
}

/* Course Header Card */
.course-header-card{
background:white;
border-radius:18px;
box-shadow:0 8px 24px rgba(0,0,0,0.08);
padding:28px 30px;
margin-bottom:24px;
}

/* Course Title */
.course-header-card h2{
margin:0 0 8px;
font-size:26px;
color:#1f2d3d;
}

/* Subtitle Text */
.course-header-card .subtext{
color:#667085;
font-size:15px;
}

/* Lessons Container */
.course-content{
display:grid;
gap:20px;
}

/* Lesson Card */
.lesson-card{
background:white;
padding:22px;
border-radius:16px;
box-shadow:0 8px 30px rgba(38,78,121,0.06);
transition:transform 0.25s ease,box-shadow 0.25s ease;
}

/* Lesson Card Hover */
.lesson-card:hover{
transform:translateY(-2px);
box-shadow:0 12px 40px rgba(38,78,121,0.08);
}

/* Lesson Title */
.lesson-card h3{
margin:0 0 10px;
color:#1f2d3d;
}

/* Lesson Description */
.lesson-card p{
margin:7px 0;
color:#475569;
font-size:14px;
}

/* Lesson Button */
.lesson-card a{
display:inline-block;
margin-top:14px;
padding:10px 18px;
border-radius:999px;
background:#2b7de9;
color:white;
font-size:14px;
text-decoration:none;
transition:background 0.3s ease;
}

/* Button Hover Effect */
.lesson-card a:hover{
background:#1e5fb8;
}

/* Back Link */
.back-link{
display:inline-flex;
align-items:center;
gap:8px;
margin-bottom:20px;
color:#2b7de9;
font-weight:600;
}

/* Back Link Hover */
.back-link:hover{
color:#1e5fb8;
}

/* Footer Spacing */
.footer{
margin-top:32px;
}

</style>
</head>

<body>

<!-- Main Page Container -->
<div class="page-container">

<!-- Sidebar Navigation -->
<div class="sidebar">

<!-- Logo Section -->
<div class="logo">
<img src="/img/logoBleu.png" class="logo-img" alt="logo">
<span>Eduphin</span>
</div>

<!-- Sidebar Menu -->
<div class="menu">
<ul>

<!-- Dashboard Link -->
<li><a href="/studentDashboard/">Dashboard</a></li>

<!-- All Courses Link -->
<li><a href="/courses/All">All Courses</a></li>

<!-- Favorite Courses Link -->
<li><a href="/favoriteCourses/All">Favorite Courses</a></li>

<!-- Profile Link -->
<li><a href="/profile/Profile-view">My Profile</a></li>

</ul>
</div>

<!-- Logout Button -->
<a href="/home">
<button class="logout" id="logoutBtn">
<i class="fas fa-sign-out-alt"></i> Sign out
</button>
</a>

</div>

<!-- Main Content -->
<div class="main">

<!-- Header Section -->
<div class="main-header">

<!-- Page Title -->
<h2><span>Course Lessons</span></h2>

<!-- Header Actions -->
<div class="header-actions">

<!-- Search Input -->
<input type="text" id="searchInput" class="search-bar" placeholder="Search lessons...">

<!-- Header Buttons -->
<div class="buttons">

<!-- Notifications Button -->
<a href="/App/notifications" class="notif-btn">
<button class="icon-btn">
🔔
<span class="notif-badge">0</span>
</button>
</a>

<!-- Chat Button -->
<button class="icon-btn" id="chatBtn">💬</button>

<!-- Profile Button -->
<a href="/profile/Profile-view">
<button class="icon-btn">👤</button>
</a>

</div>
</div>
</div>

<!-- Course Details Section -->
<div class="course-page-container">

<!-- Course Header -->
<div class="course-header-card">

<!-- Dynamic Course Title -->
<h2><%= course.Title %></h2>

<!-- User Level -->
<p class="subtext">
Lessons for level:
<strong><%= userLevel %></strong>
</p>

<!-- Back Navigation -->
<a class="back-link" href="/studentDashboard/">
⬅ Back to Dashboard
</a>

</div>

<!-- Lessons List -->
<div class="course-content">

<!-- Check If Lessons Exist -->
<% if (lessons.length > 0) { %>

<!-- Loop Through Lessons -->
<% lessons.forEach((lesson, index) => { %>

<!-- Single Lesson Card -->
<div class="lesson-card">

<!-- Lesson Title -->
<h3>
Lesson <%= index + 1 %>: <%= lesson.name %>
</h3>

<!-- Lesson Level -->
<p>Level: <%= lesson.level %></p>

<!-- Lesson Duration -->
<p>Duration: <%= lesson.duration %></p>

<!-- Check Lesson Type -->
<% if (lesson.type === "video") { %>

<!-- Video Lesson Button -->
<a href="<%= lesson.file %>" target="_blank" onclick="trackLessonOpen('<%= lesson._id %>')">
▶ Watch Video
</a>

<% } else { %>

<!-- PDF Lesson Button -->
<a href="<%= lesson.file %>" target="_blank" onclick="trackLessonOpen('<%= lesson._id %>')">
📄 Open PDF
</a>

<% } %>

</div>

<% }) %>

<% } else { %>

<!-- No Lessons Message -->
<div class="lesson-card">
<p>No lessons available for your level.</p>
</div>

<% } %>

</div>
</div>

<!-- Footer -->
<div class="footer">
© 2026 Eduphin. All rights reserved.
</div>

</div>
</div>

<!-- Track Lesson Open -->
<script>

/* Sends request when lesson is opened */
function trackLessonOpen(lessonId){

fetch('/courses/api/open-lesson',{

method:'POST',

headers:{
'Content-Type':'application/json'
},

/* Send Course ID And Lesson ID */
body:JSON.stringify({
courseId:'<%= course._id %>',
lessonId
}),

/* Keep Request Alive */
keepalive:true

}).catch(()=>{});

return true;
}

</script>

<!-- Tidio Chat Script -->
<script src="//code.tidio.co/ihlzjyy4poj2j2yjxbswichcqxzfdlfk.js" async></script>
<!-- Chat Button Function -->
<script>
/* Wait Until Chat Loads */
document.addEventListener('tidioChat-ready',function(){
const chatBtn=document.getElementById('chatBtn');
if(chatBtn){
/* Open Chat On Click */
chatBtn.addEventListener('click',function(){

window.tidioChatApi.open();

});
}
});
</script>
</body>
</html>