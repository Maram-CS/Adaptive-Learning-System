<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Courses - Eduphin</title>
<link rel="stylesheet" href="/Style/courses.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body>

<div class="page-container">

<!-- ==================== SIDEBAR ==================== -->
<div class="sidebar">
  <div class="logo">
    <img src="/img/logoBleu.png" class="logo-img" alt="Eduphin logo">
    <span>My Courses</span>
  </div>
  <div class="menu">
    <ul>
      <li class="active"><a href="/courses/All">All Courses</a></li>
      <li><a href="/studentDashboard/">Dashboard</a></li>
      <li><a href="/favoriteCourses/All">Favorite Courses</a></li>
      <li><a href="/profile/Profile-view">My Profile</a></li>
    </ul>
  </div>
  <!-- Logout button -->
  <a href="/home">
    <button class="logout" id="logoutBtn"><i class="fas fa-sign-out-alt"></i> Sign out</button>
  </a>
</div>

<!-- ==================== MAIN CONTENT ==================== -->
<div class="main">

<!-- Header with search and user actions -->
<div class="main-header">
  <h2>Courses <span>Dashboard</span></h2>
  <div class="header-actions">
    <!-- Search input for filtering courses -->
    <input type="text" id="searchInput" class="search-bar" placeholder="Search courses...">
    <div class="buttons">
      <!-- Notification button with badge -->
      <a href="/App/notifications" class="notif-btn">
        <button class="icon-btn">🔔 <span class="notif-badge">0</span></button>
      </a>
      <!-- Chat button (opens Tidio chat) -->
      <button class="icon-btn" id="chatBtn">💬</button>
      <!-- Profile button -->
      <a href="/profile/Profile-view">
        <button class="icon-btn">👤</button>
      </a>
    </div>
  </div>
</div>

<!-- ==================== FILTER BUTTONS ==================== -->
<div class="filter-buttons">
  <button onclick="filterCourses('all', this)" class="active-filter">All</button>
  <button onclick="filterCourses('frontend', this)">Frontend</button>
  <button onclick="filterCourses('backend', this)">Backend</button>
  <button onclick="filterCourses('database', this)">Database</button>
  <button onclick="filterCourses('tools', this)">Tools</button>
  <button onclick="filterCourses('design', this)">Design</button>
  <button onclick="filterCourses('deployment', this)">Deployment</button>
</div>

<!-- ==================== COURSES GRID ==================== -->
<div class="courses-container" id="coursesContainer">
  <!-- Loop through all courses passed from server -->
  <% courses.forEach(course => { %>
    <div class="item" data-category="<%= course.category %>">
      
      <!-- Favorite button (heart) -->
      <button class="heart-btn <%= favoriteIds.includes(String(course._id)) ? 'active' : '' %>"
              data-id="<%= course._id %>"
              onclick="toggleFavorite('<%= course._id %>', this)">
        <i class="fas fa-heart"></i>
      </button>
      
      <!-- Course image -->
      <img src="<%= course.image %>" class="course-img" alt="<%= course.Title %>">
      
      <!-- Course title and description -->
      <h3><%= course.Title %></h3>
      <p><%= course.Description %></p>
      
      <div class="card-divider"></div>
      
      <!-- Star rating component (populated by JavaScript) -->
      <div class="star-rating" data-course="<%= course._id %>"></div>
      <div class="rating-label">Tap to rate</div>
      
      <!-- View details button -->
      <button class="view-details-btn" onclick="viewCourseDetails('<%= course.slug %>')">
        <i class="fas fa-play-circle"></i> View Details
      </button>
    </div>
  <% }) %>
</div>

</div> <!-- end main -->
</div> <!-- end page-container -->

<!-- Toast notification for favorite actions -->
<div class="fav-toast" id="favToast"></div>
<div class="footer">© 2026 Eduphin. All rights reserved.</div>

<script>
// ==================== FAVORITES SYSTEM ====================

// List of favorite course IDs passed from the server controller
const favoriteIdsFromServer = <%- JSON.stringify(Array.isArray(favoriteIds) ? favoriteIds : []) %>;

/**
 * setHeartState - Updates the visual state of a favorite button
 * @param {HTMLElement} btn - The heart button element
 * @param {boolean} isFavorite - Whether the course is favorited
 */
function setHeartState(btn, isFavorite) {
  btn.classList.toggle('active', !!isFavorite);
  // Add pop animation for visual feedback
  btn.classList.remove('heart-pop');
  void btn.offsetWidth; // Force reflow to restart animation
  btn.classList.add('heart-pop');
}

/**
 * showToast - Displays a temporary toast notification
 * @param {string} msg - Message to display
 */
function showToast(msg) {
  const toast = document.getElementById('favToast');
  if (!toast) return;
  toast.textContent = msg;
  toast.classList.add('show');
  setTimeout(() => toast.classList.remove('show'), 2000);
}

/**
 * toggleFavorite - Toggles a course's favorite status via API
 * @param {string} id - Course ID
 * @param {HTMLElement} btn - The heart button that was clicked
 */
async function toggleFavorite(id, btn) {
  try {
    // Send POST request to toggle favorite status
    const res = await fetch('/favoriteCourses/toggle', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ courseId: id }),
      credentials: 'include'
    });

    if (!res.ok) {
      const txt = await res.text().catch(() => '');
      throw new Error(`HTTP ${res.status}: ${txt}`);
    }

    const data = await res.json();
    if (!data.success && data.isFavorite === undefined) {
      throw new Error(data.message || 'Toggle failed');
    }

    const isFavorite = !!data.isFavorite;
    setHeartState(btn, isFavorite);
    showToast(isFavorite ? 'Added to favorites ❤️' : 'Removed from favorites');

    // Update in-memory favorite list
    const idStr = String(id);
    if (isFavorite) {
      if (!favoriteIdsFromServer.includes(idStr)) favoriteIdsFromServer.push(idStr);
    } else {
      const idx = favoriteIdsFromServer.indexOf(idStr);
      if (idx !== -1) favoriteIdsFromServer.splice(idx, 1);
    }

    // Sync all hearts in case the same course appears multiple times
    syncHearts();

  } catch (err) {
    console.error(err);
    showToast('Favorite update failed');
  }
}

/**
 * syncHearts - Synchronizes all heart buttons with the favorite IDs list
 * Used to ensure UI consistency across the page
 */
function syncHearts() {
  const set = new Set(favoriteIdsFromServer.map(id => String(id).trim()));
  document.querySelectorAll('.heart-btn').forEach(btn => {
    const id = String(btn.getAttribute('data-id')).trim();
    btn.classList.toggle('active', set.has(id));
  });
}

// ==================== RATINGS SYSTEM ====================

// Mapping of rating values to descriptive text
const ratingText = { 
  0: 'Tap to rate', 
  1: 'Poor', 
  2: 'Fair', 
  3: 'Good', 
  4: 'Very Good', 
  5: 'Excellent 🎉' 
};

/**
 * buildStars - Creates an interactive star rating component for a course
 * @param {HTMLElement} container - The star-rating div element
 */
async function buildStars(container) {
  const id = container.dataset.course;
  const label = container.nextElementSibling; // rating-label element

  let saved = 0, average = 0, ratingsCount = 0;

  // Fetch current rating data from server
  try {
    const res = await fetch(`/courses/api/rating/${id}`);
    const data = await res.json();
    if (data.success) {
      saved        = Number(data.userRating    || 0);
      average      = Number(data.averageRating || 0);
      ratingsCount = Number(data.ratingsCount  || 0);
    }
  } catch (err) {
    console.log('Error loading rating');
  }

  container.innerHTML = '';

  // Create 5 stars
  for (let i = 1; i <= 5; i++) {
    const star = document.createElement('span');
    star.innerHTML = '★';
    star.dataset.value = i;
    star.classList.add('star');
    if (i <= saved) star.classList.add('filled');

    // Mouse enter: preview rating
    star.addEventListener('mouseenter', () => {
      highlightStars(container, i);
      label.textContent = ratingText[i];
    });

    // Mouse leave: restore saved rating
    star.addEventListener('mouseleave', () => {
      highlightStars(container, saved);
      label.textContent = saved
        ? `${ratingText[saved]} • Avg ${average.toFixed(1)} (${ratingsCount})`
        : `Tap to rate • Avg ${average.toFixed(1)} (${ratingsCount})`;
    });

    // Click: submit rating
    star.addEventListener('click', async () => {
      try {
        const response = await fetch('/courses/api/rate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ courseId: id, rating: i })
        });
        const data = await response.json();
        if (data.success) {
          saved        = Number(data.userRating    || i);
          average      = Number(data.averageRating || 0);
          ratingsCount = Number(data.ratingsCount  || 0);
          highlightStars(container, saved);
          label.textContent = `${ratingText[saved]} • Avg ${average.toFixed(1)} (${ratingsCount})`;
        } else {
          alert(data.message);
        }
      } catch (error) {
        console.error(error);
        alert('Error sending rating');
      }
    });

    container.appendChild(star);
  }

  // Initialize with saved rating
  highlightStars(container, saved);
  label.textContent = saved
    ? `${ratingText[saved]} • Avg ${average.toFixed(1)} (${ratingsCount})`
    : `Tap to rate • Avg ${average.toFixed(1)} (${ratingsCount})`;
}

/**
 * highlightStars - Fills stars up to a given value
 * @param {HTMLElement} container - Star container
 * @param {number} val - Number of stars to fill (0-5)
 */
function highlightStars(container, val) {
  container.querySelectorAll('.star').forEach(star => {
    star.classList.toggle('filled', parseInt(star.dataset.value) <= val);
  });
}

// ==================== NAVIGATION ====================

/**
 * viewCourseDetails - Navigates to course details page
 * @param {string} slug - Course slug for URL
 */
function viewCourseDetails(slug) {
  window.location.href = '/courses/course/' + slug;
}

// ==================== FILTER & SEARCH ====================

const items = document.querySelectorAll('.item');

/**
 * filterCourses - Filters courses by category
 * @param {string} cat - Category name ('all', 'frontend', etc.)
 * @param {HTMLElement} btn - The clicked filter button
 */
function filterCourses(cat, btn) {
  // Update active filter button styling
  document.querySelectorAll('.filter-buttons button').forEach(b => b.classList.remove('active-filter'));
  btn.classList.add('active-filter');
  
  // Show/hide courses based on category
  items.forEach(item => {
    item.style.display = (cat === 'all' || item.dataset.category === cat) ? 'flex' : 'none';
  });
}

// Live search functionality
document.getElementById('searchInput').addEventListener('keyup', function () {
  const val = this.value.toLowerCase();
  items.forEach(item => {
    // Search in course title and description (textContent)
    item.style.display = item.textContent.toLowerCase().includes(val) ? 'flex' : 'none';
  });
});

// ==================== INITIALIZATION ====================

// Initialize star ratings for all courses
document.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll('.star-rating').forEach(buildStars);
  syncHearts(); // Sync favorite hearts
});

// ==================== CHAT INTEGRATION (Tidio) ====================
</script>

<!-- Tidio chat script -->
<script src="//code.tidio.co/ihlzjyy4poj2j2yjxbswichcqxzfdlfk.js" async></script>
<script>
// Initialize chat button to open Tidio widget
document.addEventListener('tidioChat-ready', function () {
  document.getElementById('chatBtn').addEventListener('click', function () {
    window.tidioChatApi.open();
  });
});
</script>

<!-- Notifications script -->
<script src="/js/notifications.js"></script>

</body>
</html>